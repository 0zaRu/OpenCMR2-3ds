; Direct3D 7 fixed-function vertex processing on the PICA200 (Nintendo 3DS),
; the counterpart of fixed3d.vert for render/gfx_c3d.cpp.
;
; Matrices are column-vector rows (one register per output component). The
; projection already holds the screen rotation of the 3DS and its [-1, 0]
; depth range. Lights are in eye space, three registers each:
;   position (w 1 point/spot, 0 directional: then xyz is -direction),
;   diffuse colour, attenuation (a0, a1, a2, range squared).
; Spot lights are lit as point lights and specular light is not computed.

.fvec projection[4]
.fvec modelView[4]
.fvec tex0Matrix[2]
.fvec tex1Matrix[2]
.fvec materialDiffuse
.fvec materialAmbient
.fvec materialEmissive
.fvec ambient
.fvec lights[24]

.ivec lightLoop

.bool lighting
.bool diffuseFromVertex
.bool ambientFromVertex
.bool emissiveFromVertex
.bool reflect0
.bool reflect1
.bool tex0FromUV1
.bool tex1FromUV1
.bool normalizeNormals

.constf consts(0.0, 1.0, 0.00392156862745, 2.0)
.alias zeros consts.xxxx
.alias ones consts.yyyy
.alias inv255 consts.zzzz
.alias twos consts.wwww

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos v0
.alias innrm v1
.alias inclr v2
.alias inuv0 v4
.alias inuv1 v5

.proc main
    ; eye position r1, clip position
    mov r0.xyz, inpos
    mov r0.w, ones
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    mov r1.w, ones
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    ; eye normal r2
    dp3 r2.x, modelView[0], innrm
    dp3 r2.y, modelView[1], innrm
    dp3 r2.z, modelView[2], innrm
    mov r2.w, zeros
    ifu normalizeNormals
        dp3 r3.x, r2, r2
        rsq r3.x, r3.x
        mul r2.xyz, r3.xxxx, r2
    .end

    ; vertex colour r4 (the bytes are B, G, R, A)
    mul r4, inv255, inclr.zyxw

    ifu lighting
        mov r6, zeros
        for lightLoop
            ; to the light: position - eye * w
            mov r7, lights[aL]
            mul r8, r7.wwww, r1
            add r8, r7, -r8
            dp3 r9.x, r8, r8
            rsq r9.y, r9.x
            mul r8.xyz, r9.yyyy, r8
            dp3 r10.x, r2, r8
            max r10.x, zeros, r10.x
            ; attenuation 1 / (a0 + a1 d + a2 d^2), 0 beyond the range
            rcp r9.z, r9.y
            mov r11, lights[aL+2]
            mul r12.x, r11.y, r9.z
            add r12.x, r11.x, r12.x
            mul r13.x, r11.z, r9.x
            add r12.x, r12.x, r13.x
            rcp r12.x, r12.x
            slt r13.x, r9.x, r11.w
            mul r12.x, r12.x, r13.x
            mul r10.x, r10.x, r12.x
            mov r14, lights[aL+1]
            mul r14, r10.xxxx, r14
            add r6, r6, r14
        .end

        mov r15, materialDiffuse
        ifu diffuseFromVertex
            mov r15, r4
        .end
        mov r5, materialAmbient
        ifu ambientFromVertex
            mov r5, r4
        .end
        mov r3, materialEmissive
        ifu emissiveFromVertex
            mov r3, r4
        .end
        mul r5, ambient, r5
        add r5, r3, r5
        mul r6, r6, r15
        add r5, r5, r6
        max r5, zeros, r5
        min r5, ones, r5
        mov r5.w, r15.w
        mov outclr, r5
    .else
        mov outclr, r4
    .end

    ; texture coordinates: (u, v, 1, 1) or the camera-space reflection vector
    ; (x, y, z, 1), through the stage's texture matrix
    ifu reflect0
        call reflection
        mov r10, r9
    .else
        mov r10.xy, inuv0
        ifu tex0FromUV1
            mov r10.xy, inuv1
        .end
        mov r10.zw, ones
    .end
    dp4 outtc0.x, tex0Matrix[0], r10
    dp4 outtc0.y, tex0Matrix[1], r10

    ifu reflect1
        call reflection
        mov r10, r9
    .else
        mov r10.xy, inuv0
        ifu tex1FromUV1
            mov r10.xy, inuv1
        .end
        mov r10.zw, ones
    .end
    dp4 outtc1.x, tex1Matrix[0], r10
    dp4 outtc1.y, tex1Matrix[1], r10

    end
.end

; r9 = 2 (e.n) n - e, e = normalize(-eye), with w = 1
.proc reflection
    mov r8, -r1
    dp3 r9.x, r8, r8
    rsq r9.x, r9.x
    mul r8.xyz, r9.xxxx, r8
    dp3 r9.x, r8, r2
    mul r9.x, twos, r9.x
    mul r9.xyz, r9.xxxx, r2
    add r9.xyz, r9, -r8
    mov r9.w, ones
.end
